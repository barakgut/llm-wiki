#!/usr/bin/env python3
"""Entry point of the llm-wiki CLI. On the Bash tool's PATH: Claude Code adds a plugin's bin/, and the
SessionStart hook adds this directory when the tooling sits in a project's .claude/."""
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "scripts"))

SUB = {"pdf": "pdf_extract", "init": "init_wiki"}
name = SUB.get(sys.argv[1]) if len(sys.argv) > 1 else None
if name:
    del sys.argv[1]
__import__(name or "wiki").main()
